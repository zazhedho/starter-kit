# Copy to .env and adjust. Shared sections come first; every module has its own
# block at the end, headed `# --- <module> ---`.

# --- app ---
# APP_NAME is required and must be unique per application: authkit binds issued
# tokens to it (iss/aud), so changing it logs every user out.
APP_NAME=STARTER-KIT
APP_ENV=development
PORT=8080
GIN_MODE=release
# Time zone for the process and the database session (default Asia/Jakarta).
# APP_TIMEZONE=Asia/Jakarta

# --- remote configuration (optional) ---
# Settings can also come from Consul or a file; they fill only variables that are
# not already set, so the environment and .env always win. Set CONSUL to the
# agent address (CONSUL_PATH is the key prefix; the key read is
# <CONSUL_PATH>/<APP_ENV>, a JSON object). Without CONSUL the file
# config/<APP_ENV>.env is read, or APP_CONFIG/app.env when APP_CONFIG is set
# (a directory). A missing file is not an error.
# CONSUL=
# CONSUL_PATH=
# APP_CONFIG=
# A source whose config_id equals CONFIG_ID was applied before and is skipped.
# CONFIG_ID=

# --- http ---
# Defaults shown. Config is read with gokit.GetEnv and checked with gokit.EnvErrors().
# Durations accept 60 (seconds), 30s, 1m or 1h.
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=30s
# HTTP_WRITE_TIMEOUT=30s
# HTTP_IDLE_TIMEOUT=60s
# Time allowed for running requests to finish after SIGINT/SIGTERM (default 15s).
# HTTP_SHUTDOWN_TIMEOUT=15s
# After SIGINT/SIGTERM /readyz answers 503 and the listener stays open this long
# before connections are refused, so a load balancer notices (default 5s). It is
# part of HTTP_SHUTDOWN_TIMEOUT and must be below it; 0 closes the listener at once.
# HTTP_SHUTDOWN_DELAY=5s
# Largest accepted request body in MB, 1-1024 (default 10). Must be larger than
# MEDIA_MAX_FILE_SIZE_MB when media is enabled.
# HTTP_MAX_BODY_MB=10
# Comma-separated IPs or CIDRs of the reverse proxies whose X-Forwarded-For is
# believed (default: none, so the client IP is the connection's remote address).
# Behind a load balancer or CDN you must list it: otherwise every client looks
# like the proxy and shares one rate-limit budget.
# TRUSTED_PROXIES=10.0.0.0/8,192.168.0.1

# --- database ---
# DATABASE_URL, when set, is used as the connection string and the DB_* parts
# below are ignored. The session time zone is APP_TIMEZONE unless the URL sets
# its own (?timezone=...). The DB_* values may contain spaces, quotes,
# backslashes, @, : and /; they need no escaping here.
# DATABASE_URL=
# For Docker Compose, set DB_HOST to service name (e.g. postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASS=CHANGE_ME_DB_PASSWORD
DB_NAME=starter_kit
DB_SSLMODE=disable
# Connection pool (defaults shown)
# DB_MAX_OPEN_CONNS=100
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME=1h
# DB_CONN_MAX_IDLE_TIME=5m

# --- migrations ---
PATH_MIGRATE=file://migrations
# Run the migrations at startup (default true); the same as the -migrate flag.
# Set false when a separate job migrates the database.
RUN_MIGRATION=true

# --- auth ---
# JWT_KEY must be at least 32 characters; the placeholder is shorter on purpose,
# so the service refuses to start until you set a real key. Generate one with:
#   openssl rand -base64 48
JWT_KEY=CHANGE_ME_JWT_KEY
# Access token lifetime in minutes (default 15). The older JWT_EXP (hours) is
# read only when JWT_EXP_MINUTES is unset.
JWT_EXP_MINUTES=15
REFRESH_TOKEN_EXP_HOURS=168
# Longest life of a session, however often it is refreshed (default 720 = 30 days).
SESSION_MAX_LIFETIME_HOURS=720
# true: login, password-reset, public location and media upload routes answer 503
# when Redis fails, instead of running without their rate limits (default false).
LIMITER_FAIL_CLOSED=false
# true: users may sign in with their phone number as well as their email (default false).
LOGIN_WITH_PHONE=false
# Google authentication
GOOGLE_CLIENT_ID=
# Optional comma-separated allowed audiences, for example web and mobile client IDs
GOOGLE_CLIENT_IDS=
PERMISSION_CACHE_TTL=5m
PERMISSION_CACHE_TTL_SECONDS=300

# --- rate limiting ---
LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_WINDOW_SECONDS=60
LOGIN_BLOCK_DURATION_SECONDS=300
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=60
# Per-IP limit on login, Google login, refresh, forgot/reset password and
# change password (defaults 30 per 60 seconds). Needs Redis.
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW_SECONDS=60

# --- email ---
# Used by optional register OTP and password reset email flows. Read into the
# SMTP section of the configuration. SMTP_HOST, SMTP_PASS and SMTP_FROM must all
# be set to use email (setting one makes the other two required); the mailer is
# only created when Redis is configured too. Empty SMTP_PORT, SMTP_USER and the
# labels mean the defaults shown.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM=
SMTP_SUBJECT=Your Registration OTP
RESET_SUBJECT=Reset Your Password
AUTH_EMAIL_APP_NAME=STARTER-KIT
CONFIG_PUBLIC_REGISTRATION=auth.public_registration_enabled
CONFIG_REGISTER_OTP=auth.register_otp_enabled
CONFIG_PASSWORD_RESET_EMAIL=auth.password_reset_email_enabled

# --- register otp ---
# OTP_SECRET is required when Redis and SMTP are both configured (no default).
# At least 32 characters whenever it is set; generate a long random value.
OTP_SECRET=
OTP_TTL=5m
OTP_TTL_SECONDS=300
OTP_COOLDOWN=60s
OTP_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT=5
OTP_RATE_WINDOW=5m
OTP_RATE_WINDOW_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- password reset ---
# RESET_SECRET is required when Redis and SMTP are both configured (no default).
# At least 32 characters whenever it is set; generate a long random value.
RESET_SECRET=
RESET_TTL=15m
RESET_TTL_SECONDS=900
RESET_COOLDOWN=60s
RESET_COOLDOWN_SECONDS=60
RESET_RATE_LIMIT=5
RESET_RATE_WINDOW=15m
RESET_RATE_WINDOW_SECONDS=900
RESET_URL_TEMPLATE=http://localhost:5173/reset-password?token={token}

# --- redis ---
# Redis is optional (sessions, rate limiting, OTP, permission cache). Uncomment
# to enable it; when REDIS_HOST or REDIS_URL is set, the service refuses to
# start if Redis is unreachable.
# For Docker Compose, set REDIS_HOST to service name (e.g. redis)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_URL=

# --- logging ---
# LOG_LEVEL: trace, debug, info, warn, error, or fatal (default info).
# Records at the chosen level and above are written; use debug locally, info or warn in production.
LOG_LEVEL=info
LOG_FORMAT=json
NODE=api
# SERVER_IP is written as server_ip on every log line (the legacy name ServerIP
# is still read). The service sets it to the host's first non-loopback IPv4
# address at startup, replacing any value set here.
# SERVER_IP=

# ---------------------------------------------------------------------------
# Modules. Rule for a new module: add its variables here under its own
# `# --- <module> ---` header, never inside a shared section above.
# Settings are read in internal/config/<module>.go, not elsewhere.
# ---------------------------------------------------------------------------

# --- location ---
# Base URL of the Location Service. The default, https://location-service-y7si.onrender.com,
# is the maintained service; point it at your own to replace it. It must be http
# or https with a host, and https unless APP_ENV is development.
# LOCATION_SERVICE_BASE_URL=https://location-service-y7si.onrender.com
LOCATION_SERVICE_TIMEOUT_SECONDS=20
# Largest accepted Location Service response in MB, 1-64 (default 4).
# LOCATION_SERVICE_MAX_RESPONSE_MB=4
# Location cache TTL. Supports duration strings like 4320h or numeric seconds.
LOCATION_CACHE_TTL=4320h
# Public GET /api/location/* requests per client IP and window (defaults 60 per
# 60 seconds). Needs Redis; without it the reads are not rate limited.
# LOCATION_RATE_LIMIT=60
# LOCATION_RATE_WINDOW_SECONDS=60

# --- media (object storage for file/image uploads) ---
# Supported providers: "minio" or "r2" (Cloudflare R2)
MEDIA_ENABLED=false
MEDIA_MAX_FILE_SIZE_MB=5
# Uploads per client IP and window, and per user and window (both need Redis;
# without Redis uploads are not rate limited and a warning is logged at startup).
MEDIA_UPLOAD_RATE_LIMIT=20
MEDIA_UPLOAD_RATE_WINDOW_SECONDS=60
# MEDIA_UPLOAD_USER_RATE_LIMIT=10
# MEDIA_UPLOAD_USER_RATE_WINDOW_SECONDS=60
# Read and write deadline for one upload request, replacing HTTP_READ_TIMEOUT and
# HTTP_WRITE_TIMEOUT for that route (default 2m).
# MEDIA_UPLOAD_TIMEOUT=2m
# Uploads in progress at once; more are answered 503 (default 8).
# MEDIA_UPLOAD_MAX_CONCURRENT=8
# The type is detected from the first bytes of the file. Only these are accepted
# in the list: image/jpeg, image/png, image/webp, image/gif, application/pdf.
# text/html and SVG are rejected at startup because they can execute active content.
MEDIA_ALLOWED_CONTENT_TYPES=application/pdf,image/gif,image/jpeg,image/png,image/webp
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=CHANGE_ME_STORAGE_ACCESS_KEY
STORAGE_SECRET_KEY=CHANGE_ME_STORAGE_SECRET_KEY
STORAGE_BUCKET_NAME=uploads
# R2 requires true. Plain http to MinIO is acceptable on a private network only.
STORAGE_USE_SSL=false
STORAGE_BASE_URL=http://localhost:9000
# Default: auto for r2, empty for minio (the server decides). Set it to your
# MinIO server's region only if you changed it.
# STORAGE_REGION=
# true: a MinIO bucket this service creates gets an anonymous read policy, so the
# URLs in the upload response work without signing. Default false (private bucket).
# STORAGE_PUBLIC_READ=false
# Cloudflare R2 (only if STORAGE_PROVIDER=r2)
# R2_ACCOUNT_ID=
